name: Merged Bank Direct + DNS Clean + Microsoft Split
desc: CN direct, bank/payment/loan/risk-control real IP direct, Microsoft auth direct, Microsoft business proxy, overseas DNS via proxy.

dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  follow-rule: true

  # 启动 / 解析 DNS 服务自身 / 代理节点域名使用
  # 保留大陆 DNS，保证中国大陆网络下 Stash 能启动、订阅节点能解析
  default-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29

  # 默认 DNS：非大陆、非直连域名使用
  # 配合 rules 里的 1.1.1.1/32 走代理，避免境外 DNS 从大陆直连
  nameserver: #!replace
    - https://1.1.1.1/dns-query

  # 替换旧 fallback，防止原配置残留大陆 DNS 或明文 DNS
  fallback: #!replace
    - https://1.1.1.1/dns-query

  # DNS 分流策略：
  # 直连类域名用大陆 DNS，保证 DNS 出口和 DIRECT 连接出口一致
  # 代理类域名不写在这里，默认走 Cloudflare DoH + 代理链
  nameserver-policy: #!replace
    # Mainland broad
    '+.cn':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
    'geosite:cn':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query

    # Mainland major banks
    '+.icbc.com.cn':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
    '+.icbc-ltd.com':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
    '+.ccb.com':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
    '+.ccb.com.cn':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
    '+.abchina.com':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
    '+.boc.cn':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
    '+.bankofchina.com':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
    '+.bankcomm.com':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
    '+.psbc.com':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
    '+.psbc.com.cn':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
    '+.cmbchina.com':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
    '+.8008205555.com':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
    '+.cib.com.cn':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
    '+.jjccb.com':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
    '+.jycbank.com':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
    '+.jx-bank.com':
      - https://223.5.5.5/dns-query
      - https://doh.pub/dns-query
    '+.spdb.com.cn':
