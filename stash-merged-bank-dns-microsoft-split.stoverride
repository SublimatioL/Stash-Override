    # Douyin / Douyin Pay / 抖音月付
    - 'douyin.com'
    - '*.douyin.com'
    - 'douyinpay.com'
    - '*.douyinpay.com'
    - 'amemv.com'
    - '*.amemv.com'
    - 'snssdk.com'
    - '*.snssdk.com'
    - 'bytedance.com'
    - '*.bytedance.com'
    - 'byteimg.com'
    - '*.byteimg.com'
    - 'pstatp.com'
    - '*.pstatp.com'
    - 'toutiao.com'
    - '*.toutiao.com'
    - 'zijieapi.com'
    - '*.zijieapi.com'
    - 'bytecdn.cn'
    - '*.bytecdn.cn'

    # Common payment / card / risk-control
    - 'unionpay.com'
    - '*.unionpay.com'
    - '95516.com'
    - '*.95516.com'
    - 'chinapay.com'
    - '*.chinapay.com'
    - 'chinaums.com'
    - '*.chinaums.com'
    - 'tenpay.com'
    - '*.tenpay.com'
    - 'weixin.qq.com'
    - '*.weixin.qq.com'
    - 'wechat.com'
    - '*.wechat.com'
    - 'qq.com'
    - '*.qq.com'
    - 'gtimg.com'
    - '*.gtimg.com'
    - 'gtimg.cn'
    - '*.gtimg.cn'
    - 'qcloud.com'
    - '*.qcloud.com'
    - 'tencentcloudapi.com'
    - '*.tencentcloudapi.com'
    - 'geetest.com'
    - '*.geetest.com'
    - 'aliyuncs.com'
    - '*.aliyuncs.com'
    - 'aliyun.com'
    - '*.aliyun.com'
    - 'alicdn.com'
    - '*.alicdn.com'
    - 'mmstat.com'
    - '*.mmstat.com'
    - 'umeng.com'
    - '*.umeng.com'
    - 'taobao.com'
    - '*.taobao.com'
    - 'tmall.com'
    - '*.tmall.com'

    # Microsoft identity / auth only
    # 注意：不要把 Teams / SharePoint / OneDrive / Outlook 放进 fake-ip-filter
    # 它们应走 Fake-IP + 代理
    - 'microsoftonline.com'
    - '*.microsoftonline.com'
    - 'msauth.net'
    - '*.msauth.net'
    - 'msftauth.net'
    - '*.msftauth.net'
    - 'msftidentity.com'
    - '*.msftidentity.com'
    - 'live.com'
    - '*.live.com'
    - 'login.microsoft.com'
    - '*.login.microsoft.com'
    - 'login.windows.net'
    - '*.login.windows.net'

