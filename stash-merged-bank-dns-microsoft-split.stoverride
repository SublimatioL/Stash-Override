name: Mainland Natural DNS

dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  follow-rule: false
  skip-cert-verify: false

  default-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29

  nameserver: #!replace
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query

  nameserver-policy: #!replace
    '+.cn':
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query
    'geosite:cn':
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query

  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - '*.localdomain'
    - '*.localhost'
    - '*.home.arpa'
    - 'localhost'
    - 'router.asus.com'
    - '*.router.asus.com'

    - 'captive.apple.com'
    - 'time.apple.com'
    - 'time-ios.apple.com'
    - 'time.*.com'
    - 'ntp.*.com'
    - '*.ntp.org.cn'

    - '*.msftncsi.com'
    - '*.msftconnecttest.com'

    - '+.stun.*.*'
    - '+.stun.*.*.*'
    - '+.stun.*.*.*.*'
    - '+.stun.*.*.*.*.*'

    # Mainland banks
    - '+.icbc.com.cn'
    - '+.icbc-ltd.com'
    - '+.ccb.com'
    - '+.ccb.com.cn'
    - '+.abchina.com'
    - '+.boc.cn'
    - '+.bankofchina.com'
    - '+.bankcomm.com'
    - '+.psbc.com'
    - '+.psbc.com.cn'
    - '+.cmbchina.com'
    - '+.8008205555.com'
    - '+.cib.com.cn'
    - '+.spdb.com.cn'
    - '+.citicbank.com'
    - '+.cebbank.com'
    - '+.cmbc.com.cn'
    - '+.hxb.com.cn'
    - '+.cgbchina.com.cn'
    - '+.pingan.com'

    # Payment / risk control
    - '+.unionpay.com'
    - '+.95516.com'
    - '+.chinapay.com'
    - '+.chinaums.com'
    - '+.alipay.com'
    - '+.alipayobjects.com'
    - '+.alipaydns.com'
    - '+.antgroup.com'
    - '+.antfin.com'
    - '+.mybank.cn'
    - '+.tenpay.com'
    - '+.wechat.com'
    - '+.weixin.qq.com'
    - '+.qq.com'
    - '+.gtimg.com'
    - '+.gtimg.cn'
    - '+.qcloud.com'
    - '+.tencentcloudapi.com'
    - '+.geetest.com'
    - '+.aliyuncs.com'
    - '+.aliyun.com'
    - '+.alicdn.com'
    - '+.mmstat.com'
    - '+.umeng.com'
    - '+.taobao.com'
    - '+.tmall.com'

    # Microsoft auth only
    - '+.microsoftonline.com'
    - '+.msauth.net'
    - '+.msftauth.net'
    - '+.msftidentity.com'
    - '+.login.microsoft.com'
    - '+.login.windows.net'
    - '+.live.com'

rules:
  # Bank / payment / auth direct
  - DOMAIN-SUFFIX,icbc.com.cn,DIRECT
  - DOMAIN-SUFFIX,icbc-ltd.com,DIRECT
  - DOMAIN-SUFFIX,ccb.com,DIRECT
  - DOMAIN-SUFFIX,ccb.com.cn,DIRECT
  - DOMAIN-SUFFIX,abchina.com,DIRECT
  - DOMAIN-SUFFIX,boc.cn,DIRECT
  - DOMAIN-SUFFIX,bankofchina.com,DIRECT
  - DOMAIN-SUFFIX,bankcomm.com,DIRECT
  - DOMAIN-SUFFIX,psbc.com,DIRECT
  - DOMAIN-SUFFIX,psbc.com.cn,DIRECT
  - DOMAIN-SUFFIX,cmbchina.com,DIRECT
  - DOMAIN-SUFFIX,8008205555.com,DIRECT
  - DOMAIN-SUFFIX,cib.com.cn,DIRECT
  - DOMAIN-SUFFIX,spdb.com.cn,DIRECT
  - DOMAIN-SUFFIX,citicbank.com,DIRECT
  - DOMAIN-SUFFIX,cebbank.com,DIRECT
  - DOMAIN-SUFFIX,cmbc.com.cn,DIRECT
  - DOMAIN-SUFFIX,hxb.com.cn,DIRECT
