dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  follow-rule: false
  skip-cert-verify: false

  default-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29

  nameserver: #!replace
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query

  nameserver-policy:
    '+.cn':
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query
    'geosite:cn':
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query

  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - '*.localhost'
    - '*.home.arpa'
    - 'captive.apple.com'
    - 'time.apple.com'
    - 'time-ios.apple.com'
    - '*.msftncsi.com'
    - '*.msftconnecttest.com'
    - '+.stun.*.*'
    - '+.stun.*.*.*'

    - '+.icbc.com.cn'
    - '+.ccb.com'
    - '+.ccb.com.cn'
    - '+.abchina.com'
    - '+.boc.cn'
    - '+.bankofchina.com'
    - '+.cmbchina.com'
    - '+.unionpay.com'
    - '+.95516.com'
    - '+.alipay.com'
    - '+.alipayobjects.com'
    - '+.tenpay.com'
    - '+.wechat.com'
    - '+.weixin.qq.com'
    - '+.qq.com'
    - '+.microsoftonline.com'
    - '+.msauth.net'
    - '+.msftauth.net'
    - '+.msftidentity.com'
    - '+.login.microsoft.com'
    - '+.login.windows.net'

rules:
  - DOMAIN-SUFFIX,icbc.com.cn,DIRECT
  - DOMAIN-SUFFIX,ccb.com,DIRECT
  - DOMAIN-SUFFIX,ccb.com.cn,DIRECT
  - DOMAIN-SUFFIX,abchina.com,DIRECT
  - DOMAIN-SUFFIX,boc.cn,DIRECT
  - DOMAIN-SUFFIX,bankofchina.com,DIRECT
  - DOMAIN-SUFFIX,cmbchina.com,DIRECT
  - DOMAIN-SUFFIX,unionpay.com,DIRECT
  - DOMAIN-SUFFIX,95516.com,DIRECT
  - DOMAIN-SUFFIX,alipay.com,DIRECT
  - DOMAIN-SUFFIX,alipayobjects.com,DIRECT
  - DOMAIN-SUFFIX,tenpay.com,DIRECT
  - DOMAIN-SUFFIX,wechat.com,DIRECT
  - DOMAIN-SUFFIX,weixin.qq.com,DIRECT
  - DOMAIN-SUFFIX,qq.com,DIRECT
  - DOMAIN-SUFFIX,microsoftonline.com,DIRECT
  - DOMAIN-SUFFIX,msauth.net,DIRECT
  - DOMAIN-SUFFIX,msftauth.net,DIRECT
  - DOMAIN-SUFFIX,msftidentity.com,DIRECT
  - DOMAIN-SUFFIX,login.microsoft.com,DIRECT
  - DOMAIN-SUFFIX,login.windows.net,DIRECT
