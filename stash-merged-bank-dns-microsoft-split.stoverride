name: Stash FakeIP TUN Bank Microsoft Optimized
desc: Use Stash Fake-IP + TUN logic. Bank/payment/auth direct real IP; overseas traffic fake-ip proxy; avoid DNS timeout.

dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16

  # 核心：Stash 日用优化版不要开 follow-rule
  # 代理域名靠 Fake-IP，不靠境外 DoH 硬解析
  follow-rule: false

  # 启动 / DNS 服务域名解析使用
  default-nameserver: #!replace
    - 223.5.5.5
    - 119.29.29.29

  # 主 DNS：大陆 DoH，保证中国大陆起点速度与可用性
  nameserver: #!replace
    - https://223.5.5.5/dns-query
    - https://doh.pub/dns-query

  # 覆盖原配置里可能存在的 fallback，避免残留 8.8.8.8 / 1.1.1.1 导致 timeout
  fallback: #!replace
    - https://223.5.5.5/dns-query

  fake-ip-filter: #!replace
    # Local / system
    - '*.lan'
    - '*.local'
    - '*.localdomain'
    - '*.localhost'
    - '*.home.arpa'
    - 'time.*.com'
    - 'ntp.*.com'
    - '*.ntp.org.cn'
    - '*.router.asus.com'
    - 'captive.apple.com'
    - 'time.apple.com'
    - 'time-ios.apple.com'

    # Mainland banks
    - 'icbc.com.cn'
    - '*.icbc.com.cn'
    - 'icbc-ltd.com'
    - '*.icbc-ltd.com'
    - 'ccb.com'
    - '*.ccb.com'
    - 'ccb.com.cn'
    - '*.ccb.com.cn'
    - 'abchina.com'
    - '*.abchina.com'
    - 'boc.cn'
    - '*.boc.cn'
    - 'bankofchina.com'
    - '*.bankofchina.com'
    - 'bankcomm.com'
    - '*.bankcomm.com'
    - 'psbc.com'
    - '*.psbc.com'
    - 'psbc.com.cn'
    - '*.psbc.com.cn'
    - 'cmbchina.com'
    - '*.cmbchina.com'
    - '8008205555.com'
    - '*.8008205555.com'
    - 'cib.com.cn'
    - '*.cib.com.cn'
    - 'jjccb.com'
    - '*.jjccb.com'
    - 'jycbank.com'
    - '*.jycbank.com'
    - 'jx-bank.com'
    - '*.jx-bank.com'
    - 'spdb.com.cn'
    - '*.spdb.com.cn'
    - 'citicbank.com'
    - '*.citicbank.com'
    - 'cebbank.com'
    - '*.cebbank.com'
    - 'cmbc.com.cn'
    - '*.cmbc.com.cn'
    - 'hxb.com.cn'
    - '*.hxb.com.cn'
    - 'cgbchina.com.cn'
    - '*.cgbchina.com.cn'
    - 'pingan.com'
    - '*.pingan.com'

    # 招联金融 / 贷款
    - 'mucfc.com'
    - '*.mucfc.com'

    # HK banks / fintech
    - 'hsbc.com.hk'
    - '*.hsbc.com.hk'
    - 'hsbc.com'
    - '*.hsbc.com'
    - 'hangseng.com'
    - '*.hangseng.com'
    - 'za.group'
    - '*.za.group'
    - 'za.bank'
    - '*.za.bank'
    - 'welab.bank'
    - '*.welab.bank'
    - 'antbank.hk'
    - '*.antbank.hk'
    - 'elebank.com'
    - '*.elebank.com'

    # UAE bank / shopping
    - 'mashreq.com'
    - '*.mashreq.com'
    - 'dubizzle.com'
    - '*.dubizzle.com'
    - 'uae.dubizzle.com'
    - 'likecard.com'
    - '*.likecard.com'
    - 'en.likecard.com'

    # Alipay / Ant / Huabei / MYbank
