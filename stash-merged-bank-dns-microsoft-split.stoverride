name: "Mainland DNS Direct FakeIP Policy"
desc: "Mainland DNS with direct rules fake-ip filter and CN DNS policy"

dns:
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
  follow-rule: false
  nameserver-policy:
    "+.cn":
      - https://doh.pub/dns-query
      - https://dns.alidns.com/dns-query
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - "*.localdomain"
    - "*.home.arpa"
    - "localhost"
    - "captive.apple.com"
    - "time.apple.com"
    - "time-ios.apple.com"
    - "*.ntp.org.cn"
    - "*.msftncsi.com"
    - "*.msftconnecttest.com"
    - "+.icbc.com.cn"
    - "+.ccb.com"
    - "+.ccb.com.cn"
    - "+.abchina.com"
    - "+.boc.cn"
    - "+.bankofchina.com"
    - "+.cmbchina.com"
    - "+.unionpay.com"
    - "+.95516.com"
    - "+.alipay.com"
    - "+.alipayobjects.com"
    - "+.alipaydns.com"
    - "+.tenpay.com"
    - "+.wechat.com"
    - "+.weixin.qq.com"
    - "+.qq.com"
    - "+.microsoftonline.com"
    - "+.msauth.net"
    - "+.msftauth.net"
    - "+.msftidentity.com"
    - "+.login.microsoft.com"
    - "+.login.windows.net"
    - "+.live.com"

rules:
  - "DOMAIN-SUFFIX,icbc.com.cn,DIRECT"
  - "DOMAIN-SUFFIX,ccb.com,DIRECT"
  - "DOMAIN-SUFFIX,ccb.com.cn,DIRECT"
  - "DOMAIN-SUFFIX,abchina.com,DIRECT"
  - "DOMAIN-SUFFIX,boc.cn,DIRECT"
  - "DOMAIN-SUFFIX,bankofchina.com,DIRECT"
  - "DOMAIN-SUFFIX,cmbchina.com,DIRECT"
  - "DOMAIN-SUFFIX,unionpay.com,DIRECT"
  - "DOMAIN-SUFFIX,95516.com,DIRECT"
  - "DOMAIN-SUFFIX,alipay.com,DIRECT"
  - "DOMAIN-SUFFIX,alipayobjects.com,DIRECT"
  - "DOMAIN-SUFFIX,alipaydns.com,DIRECT"
  - "DOMAIN-SUFFIX,tenpay.com,DIRECT"
  - "DOMAIN-SUFFIX,wechat.com,DIRECT"
  - "DOMAIN-SUFFIX,weixin.qq.com,DIRECT"
  - "DOMAIN-SUFFIX,qq.com,DIRECT"
  - "DOMAIN-SUFFIX,microsoftonline.com,DIRECT"
  - "DOMAIN-SUFFIX,msauth.net,DIRECT"
  - "DOMAIN-SUFFIX,msftauth.net,DIRECT"
  - "DOMAIN-SUFFIX,msftidentity.com,DIRECT"
  - "DOMAIN-SUFFIX,login.microsoft.com,DIRECT"
  - "DOMAIN-SUFFIX,login.windows.net,DIRECT"
  - "DOMAIN-SUFFIX,live.com,DIRECT"
