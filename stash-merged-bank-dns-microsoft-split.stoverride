rules: #!replace
  # 1. 境外 DNS 必须走代理，避免从中国大陆直连 1.1.1.1
  - IP-CIDR,1.1.1.1/32,🚀 节点选择,no-resolve
  - IP-CIDR,1.0.0.1/32,🚀 节点选择,no-resolve

  # 2. 大陆 DNS 直连，保证大陆域名 / 银行 / 支付 DNS 和 DIRECT 出口一致
  - IP-CIDR,223.5.5.5/32,DIRECT,no-resolve
  - IP-CIDR,119.29.29.29/32,DIRECT,no-resolve
  - IP-CIDR,120.53.53.53/32,DIRECT,no-resolve
  - IP-CIDR,1.12.12.12/32,DIRECT,no-resolve

  # 3. Mainland major banks
  - DOMAIN-SUFFIX,icbc.com.cn,DIRECT
  - DOMAIN-SUFFIX,icbc-ltd.com,DIRECT
  - DOMAIN-SUFFIX,ccb.com,DIRECT
  - DOMAIN-SUFFIX,ccb.com.cn,DIRECT
  - DOMAIN-SUFFIX,abchina.com,DIRECT
  - DOMAIN-SUFFIX,boc.cn,DIRECT
  - DOMAIN-SUFFIX,bankofchina.com,DIRECT
  - DOMAIN-SUFFIX,bankcomm.com,DIRECT
